[MESSAGES CONTROL]
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring

[TYPECHECK]
generated-members =
    cv2.*,
    connect,
    emit,
    disconnect

[MASTER]
extension-pkg-allow-list =
    PySide6,
    cv2
ignore-patterns = 
    _version\.py,
ignore-paths = 
    .*\.ipynb_checkpoints,
    .*\/\.ipynb_checkpoints  